PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set this to a long random secret. Never place it in frontend/config.js or commit it.
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters
# Exact origin of your GitHub Pages website. Example: https://YOUR-USERNAME.github.io
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io
